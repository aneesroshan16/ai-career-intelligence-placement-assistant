# --- Backend API base URL ---
# Local Dev: Leave as "/api/v1". Vite's dev server proxies "/api" -> http://localhost:8000.
# Production (Vercel): Set this in the Vercel dashboard to your live backend URL.
# Example: VITE_API_BASE_URL=https://career-intel-backend.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# --- Supabase (frontend auth) ---
# Required for real signup/login/Google OAuth. Get these from your Supabase Project Settings -> API.
# In Supabase Authentication > URL Configuration, add http://localhost:5173/auth/callback and your Vercel /auth/callback URL.
# Production (Vercel): Set BOTH of these in the Vercel Dashboard Environment Variables settings!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
