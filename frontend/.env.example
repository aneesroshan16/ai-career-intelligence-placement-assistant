# --- Backend API base URL ---
# Left as "/api/v1" on purpose: Vite's dev server proxies "/api" -> http://localhost:8000
# (see vite.config.ts), so you normally do NOT need to change this for local dev.
VITE_API_BASE_URL=/api/v1

# --- Supabase (frontend auth) ---
# Required for real signup/login/Google OAuth. Get these from your Supabase
# project settings -> API. In Supabase Authentication > URL Configuration, add
# http://localhost:5173/auth/callback and your Vercel /auth/callback URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
